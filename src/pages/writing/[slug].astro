---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import AnnotationLabel from "../../components/ui/AnnotationLabel.astro";
import Tag from "../../components/ui/Tag.astro";
import { tagName } from "../../lib/tags.ts";

export async function getStaticPaths() {
  const posts = await getCollection("posts", (p) => p.data.status === "published");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} — Philip Bjørknes Krogh`}>
  <div class="mx-auto max-w-[var(--max-w)] px-4 py-12">
    <div class="mx-auto max-w-2xl">
      <AnnotationLabel>writing</AnnotationLabel>
      <h1
        class="mt-3 font-[family-name:var(--font-display)] text-[2rem] tracking-[-0.02em] text-[var(--fg)]"
      >
        {post.data.title}
      </h1>
      <div class="mt-3 flex items-center gap-4 text-[0.5rem] tracking-[0.08em] text-[var(--muted)]">
        <span>
          {post.data.publishedAt.toLocaleDateString("en-US", {
            month: "long",
            day: "numeric",
            year: "numeric",
          })}
        </span>
      </div>
      {post.data.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {post.data.tags.map((slug) => (
            <Tag label={tagName(slug)} />
          ))}
        </div>
      )}

      <div class="prose-blueprint mt-10">
        <Content />
      </div>
    </div>

    <div class="px-6 py-4 text-[0.5rem] tracking-[0.08em] text-[var(--dim)]">
      © {new Date().getFullYear()} Philip Bjørknes Krogh
    </div>
  </div>
</Base>
