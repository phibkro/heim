---
import Base from "../layouts/Base.astro";
---

<Base title="Not found — Philip Bjørknes Krogh">
  <div class="mx-auto flex min-h-[60vh] max-w-[var(--max-w)] flex-col items-center justify-center gap-4">
    <h1 class="font-[family-name:var(--font-display)] text-[5rem] tracking-[0.05em] text-[var(--accent)]">
      404
    </h1>
    <p class="text-[0.8rem] tracking-[0.1em] uppercase text-[var(--muted)]">Page not found</p>
    <a
      href="/"
      class="border border-dashed border-[var(--line-strong)] px-4 py-2 text-[0.55rem] tracking-[0.15em] uppercase text-[var(--muted)] no-underline transition-colors hover:border-[var(--accent)] hover:text-[var(--accent2)]"
    >
      ← Home
    </a>
  </div>
</Base>
