---
interface Props {
  withLine?: boolean;
  class?: string;
}
const { withLine = false, class: className = "" } = Astro.props;
---

<span
  class={`inline-flex items-center gap-2 text-[0.5rem] font-medium tracking-[0.12em] uppercase text-[var(--muted)] ${className}`}
>
  <span>// <slot /></span>
  {withLine && <span class="h-px flex-1 border-t border-dashed border-[var(--line)]" />}
</span>
