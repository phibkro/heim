---
interface Props {
  label: string;
  size?: "sm" | "md";
  class?: string;
}
const { label, size = "sm", class: className = "" } = Astro.props;
const sizeClasses = size === "sm" ? "text-[0.45rem] px-2.5 py-1" : "text-[0.5rem] px-3 py-1";
---

<span
  class={`inline-flex items-center tracking-[0.12em] uppercase border border-dashed border-[var(--line-strong)] text-[var(--muted)] hover:bg-[var(--accent)]/12 hover:border-[var(--accent)] hover:text-[var(--accent2)] transition-colors ${sizeClasses} ${className}`}
>
  {label}
</span>
